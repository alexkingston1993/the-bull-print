{
  "version": 2,
  "name": "the-bull-print",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/.well-known/security.txt",
      "destination": "/security.txt"
    },
    {
      "source": "/security.txt",
      "destination": "/security.txt"
    },
    {
      "source": "/mission-control",
      "destination": "/mission-control"
    },
    {
      "source": "/admin",
      "destination": "/mission-control"
    },
    {
      "source": "/api/mission-control/auth",
      "destination": "/api/mission-control/auth.js"
    },
    {
      "source": "/api/mission-control/telemetry",
      "destination": "/api/mission-control/telemetry.js"
    },
    {
      "source": "/api/mission-control/action",
      "destination": "/api/mission-control/action.js"
    },
    {
      "source": "/go/:broker",
      "destination": "/api/go?broker=:broker"
    },
    {
      "source": "/api/go/:broker",
      "destination": "/api/go?broker=:broker"
    },
    {
      "source": "/go",
      "destination": "/tools"
    },
    {
      "source": "/stocks/:symbol",
      "destination": "/stock"
    },
    {
      "source": "/stocks",
      "destination": "/stock"
    },
    {
      "source": "/screens/:slug",
      "destination": "/screener"
    },
    {
      "source": "/screens",
      "destination": "/screener"
    },
    {
      "source": "/screener",
      "destination": "/screener"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio"
    },
    {
      "source": "/calculators",
      "destination": "/calculators"
    },
    {
      "source": "/article/:slug",
      "destination": "/article"
    },
    {
      "source": "/article",
      "destination": "/article"
    },
    {
      "source": "/events/:slug",
      "destination": "/events"
    },
    {
      "source": "/events",
      "destination": "/events"
    },
    {
      "source": "/ipo/:slug",
      "destination": "/ipo"
    },
    {
      "source": "/ipo",
      "destination": "/ipo"
    },
    {
      "source": "/unlisted/:slug",
      "destination": "/unlisted"
    },
    {
      "source": "/unlisted",
      "destination": "/unlisted"
    },
    {
      "source": "/fno",
      "destination": "/fno"
    },
    {
      "source": "/insurance",
      "destination": "/insurance"
    },
    {
      "source": "/crypto/:symbol",
      "destination": "/crypto"
    },
    {
      "source": "/crypto",
      "destination": "/crypto"
    },
    {
      "source": "/articles",
      "destination": "/articles"
    },
    {
      "source": "/schemes",
      "destination": "/schemes"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=30, s-maxage=30"
        }
      ]
    }
  ]
}
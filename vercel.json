{
  "version": 2,
  "name": "the-bull-print",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/.well-known/security.txt",
      "destination": "/security.txt"
    },
    {
      "source": "/security.txt",
      "destination": "/security.txt"
    },
    {
      "source": "/pipeline-dashboard",
      "destination": "/pipeline-dashboard"
    },
    {
      "source": "/pipeline",
      "destination": "/pipeline-dashboard"
    },
    {
      "source": "/dashboard",
      "destination": "/pipeline-dashboard"
    },
    {
      "source": "/mission-control",
      "destination": "/mission-control"
    },
    {
      "source": "/admin",
      "destination": "/mission-control"
    },
    {
      "source": "/api/mission-control/auth",
      "destination": "/api/mission-control/auth.js"
    },
    {
      "source": "/api/mission-control/telemetry",
      "destination": "/api/mission-control/telemetry.js"
    },
    {
      "source": "/api/mission-control/action",
      "destination": "/api/mission-control/action.js"
    },
    {
      "source": "/api/cron/trigger-workflow",
      "destination": "/api/cron/trigger-workflow.js"
    },
    {
      "source": "/api/cron/guardian",
      "destination": "/api/cron/guardian.js"
    },
    {
      "source": "/api/auth/tiktok/callback",
      "destination": "/api/auth/tiktok/callback.js"
    },
    {
      "source": "/go/:broker",
      "destination": "/api/go?broker=:broker"
    },
    {
      "source": "/api/go/:broker",
      "destination": "/api/go?broker=:broker"
    },
    {
      "source": "/go",
      "destination": "/tools"
    },
    {
      "source": "/stocks/:symbol",
      "destination": "/stock"
    },
    {
      "source": "/stocks",
      "destination": "/stock"
    },
    {
      "source": "/screens/:slug",
      "destination": "/screener"
    },
    {
      "source": "/screens",
      "destination": "/screener"
    },
    {
      "source": "/screener",
      "destination": "/screener"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio"
    },
    {
      "source": "/calculators",
      "destination": "/calculators"
    },
    {
      "source": "/posts/:slug*",
      "destination": "/article"
    },
    {
      "source": "/posts",
      "destination": "/articles"
    },
    {
      "source": "/article/:slug*",
      "destination": "/article"
    },
    {
      "source": "/article",
      "destination": "/article"
    },
    {
      "source": "/events/:slug",
      "destination": "/events"
    },
    {
      "source": "/events",
      "destination": "/events"
    },
    {
      "source": "/ipo/:slug",
      "destination": "/ipo"
    },
    {
      "source": "/ipo",
      "destination": "/ipo"
    },
    {
      "source": "/unlisted/:slug",
      "destination": "/unlisted"
    },
    {
      "source": "/unlisted",
      "destination": "/unlisted"
    },
    {
      "source": "/fno",
      "destination": "/fno"
    },
    {
      "source": "/insurance",
      "destination": "/insurance"
    },
    {
      "source": "/crypto/radar",
      "destination": "/crypto-radar"
    },
    {
      "source": "/crypto/upcoming",
      "destination": "/crypto-radar"
    },
    {
      "source": "/crypto/new",
      "destination": "/crypto-radar"
    },
    {
      "source": "/crypto-radar",
      "destination": "/crypto-radar"
    },
    {
      "source": "/crypto/:symbol",
      "destination": "/crypto"
    },
    {
      "source": "/crypto",
      "destination": "/crypto"
    },
    {
      "source": "/articles",
      "destination": "/articles"
    },
    {
      "source": "/schemes",
      "destination": "/schemes"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/guardian?session=market_open",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/guardian?session=mid_day",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/guardian?session=market_close",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/guardian?session=overnight",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/trigger-workflow?workflow=daily_longtail_seo.yml",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/trigger-workflow?workflow=daily_5am_production_master.yml",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/cron/trigger-workflow?workflow=daily_135pm_deferred_publisher.yml",
      "schedule": "5 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=30, s-maxage=30"
        }
      ]
    }
  ]
}